# Copie para .test.env e preencha apenas no backend.
OPENWEBUI_API_KEY=sua-chave-aqui
OPENWEBUI_BASE_URL=https://llm.ic.unicamp.br
LLM_PROVIDER=openwebui
LLM_MODEL=gemma3:12b
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=120
# Para documentos em ingles, use English. Vazio preserva o idioma da pergunta.
RETRIEVAL_LANGUAGE=
OPENWEBUI_EMBEDDING_MODEL=nomic-embed-text:latest
# Pasta com PDFs ou caminho de um unico PDF. Use / nos caminhos Windows.
local_data_path=data
FAISS_INDEX_PATH=faiss_index_openwebui
# Pasta do Drive deste projeto. Deixe vazio para usar apenas PDFs locais.
GOOGLE_DRIVE_FOLDER_ID=1LRHb0KlDshL94BoG3L0DzkM3mQJhA3J6
# Use false para iniciar com o indice existente e atualizar apenas pelo botao/CLI.
SYNC_ON_STARTUP=true
# Compartilhe a pasta como Leitor com o client_email desta conta de servico.
GOOGLE_CREDENTIALS_PATH=credentials/service_account.json
# Alternativa ao arquivo: GOOGLE_CREDENTIALS_JSON com o JSON completo em uma linha.
